rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: fetch the caller's role document
    function roleData() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }

    function isAuthed()      { return request.auth != null; }
    function isAdmin()              { return isAuthed() && roleData().role == 'admin'; }
    function isMasterAdmin()        { return isAuthed() && roleData().isMasterAdmin == true; }
    function isCommittee()          { return isAuthed() && roleData().role == 'committee'; }
    function isTpo()                { return isAuthed() && roleData().role == 'tpo'; }
    function isFacultyCoordinator() { return isAuthed() && roleData().role == 'faculty_coordinator'; }
    // hasRole: placement committee roles (students/pipeline data)
    function hasRole()              { return isAuthed() && roleData().role in ['admin', 'committee']; }
    // hasAnyRole: any recognised role (for non-sensitive shared config)
    function hasAnyRole()           { return isAuthed() && roleData().role in ['admin', 'committee', 'tpo', 'faculty_coordinator']; }
    function canViewTpoData()       { return isAdmin() || isFacultyCoordinator(); }

    function hasValidCohort() {
      return request.resource.data.cohort is string
        && request.resource.data.cohort.size() > 0
        && exists(/databases/$(database)/documents/batches/$(request.resource.data.cohort));
    }

    // ── Students ────────────────────────────────────────────────────────────
    // Committee members: read only. Admins: read + write.
    match /students/{id} {
      allow read:           if hasRole();
      allow create, update: if isAdmin() && hasValidCohort();
      allow delete:         if isAdmin();
    }

    // ── Pending Changes ─────────────────────────────────────────────────────
    // Admins and committee members can propose (create) changes.
    // Only admins can review (approve/reject) — and not their own proposals.
    // Proposers (admin or committee) can withdraw their own pending proposals.
    match /pendingChanges/{id} {
      allow read: if hasRole();

      allow create: if (isAdmin() || isCommittee())
        && request.resource.data.proposedBy == request.auth.uid
        && request.resource.data.status    == 'pending';

      // Review path: a different admin approves/rejects pending proposals.
      // Withdraw path: proposer (admin or committee) withdraws their own pending proposal.
      allow update: if resource.data.status == 'pending'
        && request.resource.data.proposedBy == resource.data.proposedBy
        && (
          (
            isAdmin()
            && resource.data.proposedBy != request.auth.uid
            && request.resource.data.status in ['approved', 'rejected']
          )
          ||
          (
            (isAdmin() || isCommittee())
            && resource.data.proposedBy == request.auth.uid
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.withdrawnBy == request.auth.uid
          )
        );
    }

    // ── Roles ───────────────────────────────────────────────────────────────
    // Any authenticated user can read roles (needed to check their own role).
    // Any authenticated user can create their OWN role doc on first login.
    //   (Bootstrap path — allowlist check on the client enforces who can reach this.)
    // Only master admin can update/delete any role doc (role management UI).
    match /roles/{uid} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // ── Audit Log ───────────────────────────────────────────────────────────
    // Immutable. Admins can append; nobody can modify or delete.
    match /auditLog/{id} {
      allow read:          if hasRole();
      allow create:        if isAdmin();
      allow update, delete: if false;
    }

    // ── Batches ─────────────────────────────────────────────────────────────
    // Cohort docs. TPOs and faculty incharges need these for the cohort picker.
    match /batches/{batchId} {
      allow read:          if hasAnyRole();
      allow create, update: if isAdmin();
      allow delete:         if isMasterAdmin();
    }

    // ── Config ──────────────────────────────────────────────────────────────
    // Shared app config.
    // /config/authorizedUsers: any authenticated user needs to read it for the allowlist check.
    //   Write is master-admin only.
    // /config/apolloUsage: the Apollo credit/budget counter. Written ONLY by
    //   Cloud Functions via the Admin SDK (which bypasses these rules). Deny all
    //   client writes so no one — not even an admin — can tamper with the
    //   spend budget from the browser. Readable by placement committee for the
    //   usage tracker UI.
    match /config/{docId} {
      allow read:  if isAuthed();
      allow write: if docId == 'apolloUsage'    ? false
                   : docId == 'authorizedUsers' ? isMasterAdmin()
                   : isAdmin();
    }

    // ── Outreach Contacts (Apollo enrichment) ────────────────────────────────
    // Enriched LinkedIn contacts. Admin + committee can read and create.
    // Phone fields are filled asynchronously by the apolloPhoneWebhook Cloud
    // Function (Admin SDK, bypasses rules). Clients may update non-budget fields
    // (e.g. notes) but the enrichment pipeline is server-driven.
    // Read: any recognised role (same category as Intel recruiter contact data,
    //   which is already hasAnyRole-readable). This lets the Admin "Team Access"
    //   page grant the Outreach PAGE to tpo / faculty_incharge without their
    //   reads throwing a rules error — the page toggle then genuinely controls
    //   who sees the tab.
    // Write: admin + committee only (they manage the contact list).
    // Spending Apollo credits is a separate concern: the enrichContacts Cloud
    //   Function enforces admin|committee server-side regardless of any UI toggle,
    //   so no permission-grid change can ever let another role spend money.
    match /outreachContacts/{id} {
      allow read:   if hasAnyRole();
      allow create: if hasRole();
      allow update: if hasRole();
      allow delete: if isAdmin();
    }

    // ── Apollo call ledger ────────────────────────────────────────────────────
    // Append-only log used by the Cloud Function for the hourly rate limit.
    // Written by the function (Admin SDK). Readable by committee for debugging;
    // no client writes.
    match /apolloCallLog/{id} {
      allow read:  if hasRole();
      allow write: if false;
    }

    // ── Templates ───────────────────────────────────────────────────────────
    // Column-mapping templates are non-sensitive; any authed user can manage them.
    match /templates/{id} {
      allow read, write: if isAuthed();
    }

    // ── User Preferences ─────────────────────────────────────────────────────
    // Per-user UI preferences (column visibility, sorting, etc.).
    match /userPrefs/{uid} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
    }

    // ── Opportunities & Pipeline ─────────────────────────────────────────────
    // All authenticated users can read opportunities (the Activity feed).
    // Only admins can create/update/delete opportunities and advance stages.
    match /opportunities/{oppId} {
      allow read: if isAuthed();
      allow write: if isAdmin();

      match /stages/{stageId} {
        allow read: if isAuthed();
        allow write: if isAdmin();
      }

      match /applicants/{applicantId} {
        allow read: if isAuthed();
        allow write: if isAdmin();
      }
    }

    // collectionGroup query support for the heatmap (reads all applicants subcollections at once)
    match /{path=**}/applicants/{applicantId} {
      allow read: if isAuthed();
    }

    // ── TPO Profiles & Outreach ──────────────────────────────────────────────
    // tpoProfiles/{tpoUid}: profile doc created by the TPO on first load.
    // tpoProfiles/{tpoUid}/outreach/{id}: outreach entries only the owning TPO
    //   (or admins) can write; admins and faculty_incharges can read all.
    match /tpoProfiles/{tpoUid} {
      allow read:  if canViewTpoData() || (isTpo() && request.auth.uid == tpoUid);
      allow create: if isTpo() && request.auth.uid == tpoUid;
      allow update: if isAdmin() || (isTpo() && request.auth.uid == tpoUid);
      allow delete: if isAdmin();

      match /outreach/{outreachId} {
        allow read:   if canViewTpoData() || (isTpo() && request.auth.uid == tpoUid);
        allow create: if (isAdmin() || (isTpo() && request.auth.uid == tpoUid))
                        && request.resource.data.createdBy == request.auth.uid;
        allow update: if (isAdmin() || (isTpo() && request.auth.uid == tpoUid));
        allow delete: if isAdmin() || (isTpo() && request.auth.uid == tpoUid);
      }
    }

    // collectionGroup query so admins/faculty_incharges can read all outreach at once
    match /{path=**}/outreach/{outreachId} {
      allow read: if canViewTpoData();
    }

    // ── Intel (Recruiter Intelligence) ──────────────────────────────────────────
    // All authenticated roles can read (intel is shared competitive intelligence).
    // Admin and committee can create/update (write intel records and edits).
    // Only admin can bulk-upload (enforced client-side via uploadIntel action;
    //   rules allow create/update for admin|committee since bulk upload = batch creates).
    // Soft-delete: update sets _deleted=true. Hard delete: admin only.
    // _deleted records are readable (needed for audit trail) but filtered client-side.
    match /intel/{docId} {
      allow read:          if hasAnyRole();
      allow create:        if (isAdmin() || isCommittee())
                             && request.resource.data.createdBy == request.auth.uid;
      allow update:        if (isAdmin() || isCommittee())
                             && request.resource.data.updatedBy == request.auth.uid;
      allow delete:        if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
