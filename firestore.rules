rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: fetch the caller's role document
    function roleData() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }

    function isAuthed()      { return request.auth != null; }
    function isAdmin()              { return isAuthed() && roleData().role == 'admin'; }
    function isMasterAdmin()        { return isAuthed() && roleData().isMasterAdmin == true; }
    function isTpo()                { return isAuthed() && roleData().role == 'tpo'; }
    function isFacultyCoordinator() { return isAuthed() && roleData().role == 'faculty_coordinator'; }
    // hasRole: existing placement committee roles only (students/pipeline data)
    function hasRole()              { return isAuthed() && roleData().role in ['admin', 'committee', 'viewer']; }
    // hasAnyRole: any recognised role (for non-sensitive shared config)
    function hasAnyRole()           { return isAuthed() && roleData().role in ['admin', 'committee', 'viewer', 'tpo', 'faculty_coordinator']; }
    function canViewTpoData()       { return isAdmin() || isFacultyCoordinator(); }
    
    function hasValidCohort() {
      return request.resource.data.cohort is string
        && request.resource.data.cohort.size() > 0
        && exists(/databases/$(database)/documents/batches/$(request.resource.data.cohort));
    }

    // ── Students ────────────────────────────────────────────────────────────
    // Viewers: read only. Admins: read + write.
    // Direct writes by admins are allowed; the approval workflow is enforced
    // at the app layer and backed by the immutable auditLog.
    match /students/{id} {
      allow read:           if hasRole();
      allow create, update: if isAdmin() && hasValidCohort();
      allow delete:         if isAdmin();
    }

    // ── Pending Changes ─────────────────────────────────────────────────────
    // Only admins can propose (create) or review (update) changes.
    // An admin cannot approve/reject their own proposal (enforced here AND in app).
    match /pendingChanges/{id} {
      allow read: if hasRole();

      allow create: if isAdmin()
        && request.resource.data.proposedBy == request.auth.uid
        && request.resource.data.status    == 'pending';

      // Review path: a different admin approves/rejects pending proposals.
      // Withdraw path: proposer withdraws their own pending proposal.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.proposedBy == resource.data.proposedBy
        && (
          (
            resource.data.proposedBy != request.auth.uid
            && request.resource.data.status in ['approved', 'rejected']
          )
          ||
          (
            resource.data.proposedBy == request.auth.uid
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.withdrawnBy == request.auth.uid
          )
        );
    }

    // ── Roles ───────────────────────────────────────────────────────────────
    // Any authenticated user can read roles (needed to check their own role).
    // Any authenticated user can create their OWN role doc on first login.
    // Only the master admin can promote/demote others.
    match /roles/{uid} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // ── Audit Log ───────────────────────────────────────────────────────────
    // Immutable. Admins can append; nobody can modify or delete.
    match /auditLog/{id} {
      allow read:          if hasRole();
      allow create:        if isAdmin();
      allow update, delete: if false;
    }

    // ── Batches ─────────────────────────────────────────────────────────────
    // Cohort docs. TPOs and faculty coordinators need these for the cohort picker.
    match /batches/{batchId} {
      allow read:          if hasAnyRole();
      allow create, update: if isAdmin();
      allow delete:         if isMasterAdmin();
    }

    // ── Config ──────────────────────────────────────────────────────────────
    // Shared app config. TPOs need rolePermissions to resolve field visibility.
    match /config/{docId} {
      allow read:  if hasAnyRole();
      allow write: if isAdmin();
    }

    // ── Templates ───────────────────────────────────────────────────────────
    // Column-mapping templates are non-sensitive; any authed user can manage them.
    match /templates/{id} {
      allow read, write: if isAuthed();
    }

    // ── User Preferences ─────────────────────────────────────────────────────
    // Per-user UI preferences (column visibility, sorting, etc.).
    match /userPrefs/{uid} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
    }

    // ── Opportunities & Pipeline ─────────────────────────────────────────────
    // All authenticated users can read opportunities (the Activity feed).
    // Only admins can create/update/delete opportunities and advance stages.
    match /opportunities/{oppId} {
      allow read: if isAuthed();
      allow write: if isAdmin();

      match /stages/{stageId} {
        allow read: if isAuthed();
        allow write: if isAdmin();
      }

      match /applicants/{applicantId} {
        allow read: if isAuthed();
        allow write: if isAdmin();
      }
    }

    // collectionGroup query support for the heatmap (reads all applicants subcollections at once)
    match /{path=**}/applicants/{applicantId} {
      allow read: if isAuthed();
    }

    // ── TPO Profiles & Outreach ──────────────────────────────────────────────
    // tpoProfiles/{tpoUid}: profile doc created by the TPO on first load.
    // tpoProfiles/{tpoUid}/outreach/{id}: outreach entries only the owning TPO
    //   (or admins) can write; admins and faculty_coordinators can read all.
    match /tpoProfiles/{tpoUid} {
      allow read:  if canViewTpoData() || (isTpo() && request.auth.uid == tpoUid);
      allow create: if isTpo() && request.auth.uid == tpoUid;
      allow update: if isAdmin() || (isTpo() && request.auth.uid == tpoUid);
      allow delete: if isAdmin();

      match /outreach/{outreachId} {
        allow read:   if canViewTpoData() || (isTpo() && request.auth.uid == tpoUid);
        allow create: if (isAdmin() || (isTpo() && request.auth.uid == tpoUid))
                        && request.resource.data.createdBy == request.auth.uid;
        allow update: if (isAdmin() || (isTpo() && request.auth.uid == tpoUid));
        allow delete: if isAdmin() || (isTpo() && request.auth.uid == tpoUid);
      }
    }

    // collectionGroup query so admins/faculty_coordinators can read all outreach at once
    match /{path=**}/outreach/{outreachId} {
      allow read: if canViewTpoData();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
