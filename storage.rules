rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /imports/{allPaths=**} {
      // Import files (CSV/Excel uploads) — admin and committee only
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role
           in ['admin', 'committee'];
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role
           == 'admin';
    }
  }
}
